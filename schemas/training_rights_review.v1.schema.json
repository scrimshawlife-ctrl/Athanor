{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athanor.local/schemas/training_rights_review.v1.schema.json",
  "title": "Athanor Training Rights Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","candidate_manifest_sha256","intended_use","jurisdiction","reviewer","review_evidence_sha256","sources"],
  "properties": {
    "schema": {"const": "athanor.training_rights_review.v1"},
    "candidate_manifest_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "intended_use": {"const":"model_training"},
    "jurisdiction": {"type":"string","minLength":1},
    "reviewer": {"type":"string","minLength":1},
    "review_evidence_sha256": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "sources": {
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["source_id","work_edition_id","source_url","license_basis","decision","evidence_sha256"],
        "properties":{
          "source_id":{"type":"string","minLength":1},
          "work_edition_id":{"type":"string","minLength":1},
          "source_url":{"type":"string","minLength":1},
          "license_basis":{"type":"string","minLength":1},
          "decision":{"const":"CLEARED"},
          "evidence_sha256":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
        }
      }
    }
  }
}
