{"pair_id": "corr.astrology_west.practice.6e119a", "family_id": "astrology_west", "role": "practice", "filler": "You have great determination. You will be disappointed in love,", "span": "when young, but later in life you will regain faith", "atom_id": null, "epistemic": "OBSERVED"}
{"pair_id": "corr.astrology_west.planet.68904c", "family_id": "astrology_west", "role": "planet", "filler": "Affects the following years: 4th, 16th, 28th, 40th, 52nd, 64th,", "span": "76th, 88th. \u2014 z \u2014 The Tenth House being the", "atom_id": null, "epistemic": "OBSERVED"}
