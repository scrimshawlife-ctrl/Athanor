{"pair_id": "corr.coptic_gnostic.symbol.0d86a0", "family_id": "coptic_gnostic", "role": "symbol", "filler": "330 , 355 Anat, the goddess, assessor of Yahweh, ii.", "span": "32 n. 4 Anatolia, its religious peculiarities temp. Christ, ii.", "atom_id": null, "epistemic": "OBSERVED"}
{"pair_id": "corr.coptic_gnostic.concept.8d904e", "family_id": "coptic_gnostic", "role": "concept", "filler": "31 Anthesteria, ceremonies of, show resurrection and marriage of Dionysos,", "span": "i. 42 Anthropos, member of 3rd Valentinian syzygy, ii. 98", "atom_id": null, "epistemic": "OBSERVED"}
{"pair_id": "corr.coptic_gnostic.text.e00e53", "family_id": "coptic_gnostic", "role": "text", "filler": "78 Aphrodite, the goddess, worshipped under other names by confraternities,", "span": "i. 25; and Adonis, i. 37; ii. 31 ; daughter", "atom_id": null, "epistemic": "OBSERVED"}
