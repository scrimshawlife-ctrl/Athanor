        "artifact_ref",
        "snapshot_ref",
        "config_hash",
        "output_refs",
        "reviewer",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "applicability": {
                "const": "applicable"
              },
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "support": {
                "minimum": 1
              },
              "artifact_ref": {
                "$ref": "#/$defs/reference"
              },
              "output_refs": {
                "minItems": 1
              },
              "reviewer": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "not_applicable"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "NOT_COMPUTABLE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              },
              "gate_id": {
                "not": {
                  "enum": [
                    "E0",
                    "E4",
                    "E5",
                    "E6",
                    "E8"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "snapshot_ref": {
                "$ref": "#/$defs/reference"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {"enum": ["PASS", "FAIL"]},
              "gate_id": {"enum": ["E1", "E2", "E3"]}
            }
          },
          "then": {"properties": {"value": {"type": "number", "minimum": 0, "maximum": 1}, "control_value": {"type": "number", "minimum": 0, "maximum": 1}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["PASS", "FAIL"]}, "gate_id": {"const": "E7"}}},
          "then": {"properties": {"value": {"type": "number", "minimum": 0, "maximum": 1}, "control_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}}
        }
      ]
